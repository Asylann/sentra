# =============================================================================
# Sentra Production Environment Configuration
# =============================================================================

# API Gateway Configuration
PORT=8080
GIN_MODE=release

# GitHub App Integration
GITHUB_APP_ID=YOUR_PRODUCTION_APP_ID
GITHUB_CLIENT_ID=YOUR_PRODUCTION_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_PRODUCTION_CLIENT_SECRET
GITHUB_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_SECRET
GITHUB_PRIVATE_KEY_PATH=/etc/sentra/private-key.pem

# Database and Services
DATABASE_URL=postgres://sentra:sentra_prod_password@sentra-postgres:5432/sentra?sslmode=disable
REDIS_URL=redis://sentra-redis:6379/0
KAFKA_BROKERS=sentra-kafka:9092

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://sentra.ai/api/v1
NEXT_PUBLIC_WS_URL=wss://sentra.ai/api/v1/ws

# Authentication
JWT_SECRET=YOUR_PRODUCTION_SECURE_JWT_SECRET
FRONTEND_URL=https://sentra.ai
